{
  "name": "lekhapana",
  "version": "1.0.0",
  "private": true,
  "description": "SajiloLekha - multi-tenant business management and accounting SaaS",
  "type": "module",
  "workspaces": [
    "server",
    "client",
    "tests"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:memory": "node scripts/dev-memory.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "vitest run",
    "test:server": "vitest run tests/server",
    "test:client": "vitest run tests/client",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^5.0.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3"
  },
  "allowScripts": {
    "argon2@0.41.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "mongodb-memory-server@10.4.3": true
  }
}
