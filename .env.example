# ---------------------------------------------------------------------------
# Copy to `.env` in the repository root and adjust.
#
# Every variable here is read by `server/src/config/env.js` (or `security.js`).
# The listed default is the one the code falls back to, so a minimal file only
# has to override what differs from your machine.
#
# The server REFUSES TO BOOT in production while the JWT secrets or pepper are
# still the development placeholders.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=4000
# Where the API itself is reachable (used in emails and invoice links).
SERVER_URL=http://localhost:4000
# Where the browser app is served from (CORS origin).
CLIENT_URL=http://localhost:5173
# silent | error | warn | info | debug
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# A REPLICA SET IS REQUIRED. A standalone mongod cannot run transactions, and
# this system refuses to pretend its multi-document writes are atomic: without
# transactions it falls back to compensating rollbacks, which is correct but
# slower and less strict. Use Atlas, or a local `mongod --replSet rs0`.
MONGODB_URI=mongodb://127.0.0.1:27017/lekhapana?replicaSet=rs0
# Optional: a second connection string used only to detect transaction support.
# Leave blank when MONGODB_URI already points at a replica set.
MONGODB_URI_TXN=
MONGODB_USE_TRANSACTIONS=true
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000
# Build indexes on boot. Convenient in development; in production, create them
# deliberately, because a background index build on a large collection is slow.
MONGO_AUTO_INDEX=true

# --- Secrets ---------------------------------------------------------------
# Generate each one independently:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_me_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_me_with_a_different_32_char_secret
# Mixed into every password hash. Changing it invalidates every stored hash,
# which locks out every user until passwords are reset.
JWT_PEPPER=replace_me_with_a_third_32_char_secret
# Access tokens are short-lived and sent in the Authorization header.
JWT_ACCESS_TTL=15m
# Refresh tokens are opaque, stored hashed, and delivered as an HttpOnly cookie.
JWT_REFRESH_TTL=30d
# Only used by the bcryptjs migration path for legacy hashes.
BCRYPT_ROUNDS=12

# --- Cookies ---------------------------------------------------------------
# Set to true once the API is served over HTTPS; the refresh cookie then
# refuses to travel over plain HTTP.
COOKIE_SECURE=false
# lax | strict | none. `none` requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax
# Leave blank unless you serve the API from a different host to the app.
COOKIE_DOMAIN=

# --- Security --------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
# Deliberately much lower: auth endpoints are the ones worth brute forcing.
AUTH_RATE_LIMIT_MAX=15
SECURITY_HEADERS_ENABLED=true
# Trust X-Forwarded-For / X-Forwarded-Proto. Enable ONLY behind a proxy you
# control — otherwise a client can spoof its own IP and sidestep rate limits.
TRUST_PROXY=false

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=./uploads
# 5 MiB. Applies to product images and invoice attachments.
MAX_UPLOAD_BYTES=5242880

# --- Defaults applied to a NEW workspace -----------------------------------
# Existing workspaces keep whatever they were created with.
DEFAULT_CURRENCY=NPR
DEFAULT_CURRENCY_SYMBOL=Rs.
DEFAULT_LOCALE=en-NP
DEFAULT_TIMEZONE=Asia/Kathmandu

# --- Development seed ------------------------------------------------------
# `npm run seed` builds a workspace with ~45 days of realistic activity so the
# dashboard has something honest to show. Change the password before sharing
# a seeded environment with anyone.
SEED_ADMIN_NAME=SajiloLekha Owner
SEED_ADMIN_EMAIL=owner@lekhapana.test
SEED_ADMIN_PASSWORD=ChangeMe!2024
SEED_DAYS=45
# Fixes the generated data so two seeds produce comparable figures.
SEED_RANDOM_SEED=20260814
# Seed automatically on `npm run dev` when the database is empty.
SEED_DEMO_DATA=false
